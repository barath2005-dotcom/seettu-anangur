PORT=4000
NODE_ENV=production
# For PostgreSQL in production:
DATABASE_URL="postgresql://postgres:password@localhost:5432/seettu_db?schema=public"
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
JWT_REFRESH_SECRET=replace-with-another-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=https://seettu.example.com
